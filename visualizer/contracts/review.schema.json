{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "kind": {
      "type": "string",
      "const": "rotation-review"
    },
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "strategy": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/__schema0"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        }
      },
      "required": [
        "id",
        "revision"
      ],
      "additionalProperties": false
    },
    "caseId": {
      "$ref": "#/$defs/__schema0"
    },
    "momentId": {
      "$ref": "#/$defs/__schema0"
    }
  },
  "required": [
    "kind",
    "schemaVersion",
    "strategy",
    "caseId",
    "momentId"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,95}$"
    }
  }
}
