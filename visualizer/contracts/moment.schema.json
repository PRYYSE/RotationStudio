{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "$ref": "#/$defs/__schema0"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 120000
    },
    "athletes": {
      "minItems": 6,
      "maxItems": 6,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema1"
      }
    },
    "cue": {
      "$ref": "#/$defs/__schema3"
    }
  },
  "required": [
    "id",
    "name",
    "ms",
    "athletes"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,95}$"
    },
    "__schema1": {
      "type": "object",
      "properties": {
        "slot": {
          "$ref": "#/$defs/__schema0"
        },
        "position": {
          "$ref": "#/$defs/__schema2"
        },
        "duty": {
          "type": "string",
          "enum": [
            "ready",
            "serve",
            "receive",
            "set",
            "attack",
            "block",
            "cover",
            "recover",
            "defend"
          ]
        },
        "cue": {
          "$ref": "#/$defs/__schema3"
        },
        "route": {
          "maxItems": 8,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema2"
          }
        },
        "coverage": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "ellipse"
                },
                "center": {
                  "$ref": "#/$defs/__schema2"
                },
                "radiusX": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 9
                },
                "radiusZ": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 12
                }
              },
              "required": [
                "kind",
                "center",
                "radiusX",
                "radiusZ"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "polygon"
                },
                "vertices": {
                  "minItems": 3,
                  "maxItems": 12,
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/__schema2"
                  }
                }
              },
              "required": [
                "kind",
                "vertices"
              ],
              "additionalProperties": false
            }
          ]
        }
      },
      "required": [
        "slot",
        "position",
        "duty"
      ],
      "additionalProperties": false
    },
    "__schema2": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number",
          "minimum": -4.5,
          "maximum": 4.5
        },
        "z": {
          "type": "number",
          "minimum": 0,
          "maximum": 12
        }
      },
      "required": [
        "x",
        "z"
      ],
      "additionalProperties": false
    },
    "__schema3": {
      "type": "string",
      "maxLength": 600
    }
  }
}
