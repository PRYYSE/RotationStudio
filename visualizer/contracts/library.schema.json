    },
    "__schema20": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/__schema2"
        },
        "sha256": {
          "type": "string",
          "format": "sha256_hex",
          "pattern": "^[0-9a-fA-F]{64}$"
        },
        "baseSha256": {
          "type": "string",
          "format": "sha256_hex",
          "pattern": "^[0-9a-fA-F]{64}$"
        },
        "raw": {
          "type": "string",
          "maxLength": 1000000
        },
        "eventMap": {
          "maxItems": 4800,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema21"
          }
        },
        "issues": {
          "maxItems": 100,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema5"
          }
        }
      },
      "required": [
        "id",
        "sha256",
        "baseSha256",
        "raw",
        "eventMap",
        "issues"
      ],
      "additionalProperties": false
    },
    "__schema21": {
      "type": "object",
      "properties": {
        "caseId": {
          "$ref": "#/$defs/__schema2"
        },
        "old": {
          "$ref": "#/$defs/__schema2"
        },
        "moment": {
          "$ref": "#/$defs/__schema2"
        }
      },
      "required": [
        "caseId",
        "old",
        "moment"
      ],
      "additionalProperties": false
    },
    "__schema22": {
      "type": "object",
      "properties": {
        "operationId": {
          "$ref": "#/$defs/__schema2"
        },
        "fingerprint": {
          "type": "string",
          "maxLength": 64
        },
        "result": {
          "$ref": "#/$defs/__schema7"
        },
        "previous": {
          "$ref": "#/$defs/__schema7"
        },
        "restoredFrom": {
          "$ref": "#/$defs/__schema7"
        }
      },
      "required": [
        "operationId",
        "fingerprint",
        "result",
        "previous"
      ],
      "additionalProperties": false
