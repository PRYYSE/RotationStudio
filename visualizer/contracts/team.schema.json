{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "id": {
      "$ref": "#/$defs/__schema0"
    },
    "revision": {
      "$ref": "#/$defs/__schema1"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "roster": {
      "minItems": 1,
      "maxItems": 40,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema2"
      }
    },
    "league": {
      "$ref": "#/$defs/__schema2"
    },
    "notes": {
      "type": "string",
      "maxLength": 600
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "revision",
    "name",
    "roster",
    "league"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,95}$"
    },
    "__schema1": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100000
    },
    "__schema2": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/__schema0"
        },
        "revision": {
          "$ref": "#/$defs/__schema1"
        }
      },
      "required": [
        "id",
        "revision"
      ],
      "additionalProperties": false
    }
  }
}
