{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "id": {
      "$ref": "#/$defs/__schema0"
    },
    "revision": {
      "$ref": "#/$defs/__schema1"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "team": {
      "$ref": "#/$defs/__schema2"
    },
    "parent": {
      "$ref": "#/$defs/__schema2"
    },
    "adaptation": {
      "type": "string",
      "enum": [
        "original",
        "needs-review",
        "reviewed"
      ]
    },
    "slots": {
      "minItems": 6,
      "maxItems": 6,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema3"
      }
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "revision",
    "name",
    "team",
    "adaptation",
    "slots"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,95}$"
    },
    "__schema1": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100000
    },
    "__schema2": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/__schema0"
        },
        "revision": {
          "$ref": "#/$defs/__schema1"
        }
      },
      "required": [
        "id",
        "revision"
      ],
      "additionalProperties": false
    },
    "__schema3": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/__schema0"
        },
        "player": {
          "$ref": "#/$defs/__schema2"
        },
        "role": {
          "type": "string",
          "enum": [
            "setter",
            "outside",
            "middle",
            "opposite",
            "libero",
            "utility"
          ]
        },
        "notes": {
          "type": "string",
          "maxLength": 600
        }
      },
      "required": [
        "id",
        "player",
        "role"
      ],
      "additionalProperties": false
    }
  }
}
