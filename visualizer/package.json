{
  "name": "visualizer",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "RotationStudio 1.0: 3D volleyball rotations and strategy editing, with original Set arcs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "node --experimental-strip-types --experimental-test-isolation=none --test src/lib/*.test.mjs src/state/*.test.mjs",
    "fixture:private": "node --experimental-strip-types server/fixture.mjs",
    "validate:proposal": "node --experimental-strip-types scripts/validate-authoring.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^10.0.6",
    "@react-three/fiber": "^9.1.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.171.0",
    "zod": "4.6.7",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-rc.5",
    "@types/node": "22.20.5",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@types/three": "^0.171.0",
    "@vitejs/plugin-react": "4.7.0",
    "autoprefixer": "^10.4.20",
    "cf": "1.0.0-rc.5",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "7.3.8"
  }
}
